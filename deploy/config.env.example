# Copy to deploy/config.env and adjust. gcp-deploy.sh sources it if present.
#   cp deploy/config.env.example deploy/config.env

# Project to create or reuse. Must be globally unique if it does not exist yet.
PROJECT_ID=news-fanout-demo

# Required only when the project has to be created.
# Find yours with: gcloud billing accounts list
BILLING_ACCOUNT=017D09-388CDF-100DBB

REGION=europe-west4
ZONE=europe-west4-a

VM_NAME=news-fanout-vm
MACHINE_TYPE=e2-small
DISK_SIZE=20GB

AR_REPO=news-fanout
IMAGE_NAME=news-fanout
IMAGE_TAG=latest

# Postgres password on the VM. Leave empty and the script generates one, storing it
# in deploy/.secrets/<project>.postgres-password so redeploys reuse the same value.
POSTGRES_PASSWORD=

# CIDR allowed to reach port 80. Default is the whole internet; narrow it to your
# own address for a private demo, e.g. "$(curl -s ifconfig.me)/32".
ALLOW_CIDR=0.0.0.0/0
