# Settings are read with the NEWS_FANOUT_ prefix and __ as the nesting delimiter,
# so NEWS_FANOUT_DATABASE__HOST maps to AppSettings.database.host (see config.py).
# Copy to .env for a bare-metal run; the compose files set these themselves.

NEWS_FANOUT_ROLE=all

NEWS_FANOUT_DATABASE__HOST=localhost
NEWS_FANOUT_DATABASE__PORT=5432
NEWS_FANOUT_DATABASE__USER=postgres
NEWS_FANOUT_DATABASE__PASSWORD=postgres
NEWS_FANOUT_DATABASE__DATABASE=news_fanout

NEWS_FANOUT_REDIS__HOST=localhost
NEWS_FANOUT_REDIS__PORT=6379

NEWS_FANOUT_SERVER__PORT=8000
NEWS_FANOUT_SERVER__AUTO_MIGRATE=true

# Lower this to watch the digest push pipeline fire during a test run.
NEWS_FANOUT_PUSH__DIGEST_INTERVAL_SECONDS=30
# Bound the synthetic article stream (0 = unlimited).
NEWS_FANOUT_INGEST__STUB_MAX_PAGE_ID=0

LOG_LEVEL=INFO
LOG_FORMAT=json
